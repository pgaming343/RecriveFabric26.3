{
	"schemaVersion": 1,
	"id": "recrive",
	"version": "${version}",
	"name": "Recrive",
	"description": "Cloud synchronization for Minecraft saves. Automatic backup, sync worlds and player data between devices. Lightweight, built for Fabric.",
	"authors": ["purvansh"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["com.recrive.RecriveMod"]
	},
	"mixins": ["recrive.mixins.json"],
	"icon": "assets/recrive/icon.png",
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": "~26.3",
		"java": ">=25"
	}
}
